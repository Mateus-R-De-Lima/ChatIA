@* Campo de pergunta + botão enviar. Desabilita enquanto carrega. *@
<div class="chat-input">
    <textarea class="chat-input__field"
              rows="2"
              placeholder="Digite sua pergunta..."
              @bind="_text"
              @bind:event="oninput"
              @onkeydown="OnKeyDown"
              disabled="@Disabled"></textarea>

    <button class="chat-input__send"
            type="button"
            disabled="@(Disabled || string.IsNullOrWhiteSpace(_text))"
            @onclick="OnSendClicked">
        Enviar
    </button>
</div>

@code {
    private string _text = string.Empty;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    private async Task OnSendClicked()
    {
        var message = _text.Trim();
        if (string.IsNullOrWhiteSpace(message) || Disabled)
        {
            return;
        }

        _text = string.Empty;
        await OnSend.InvokeAsync(message);
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        // Enter envia; Shift+Enter quebra linha
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await OnSendClicked();
        }
    }
}
